{
  "$defs": {
    "Metadata": {
      "additionalProperties": true,
      "description": "Metadata for all entities.",
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "author": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Author"
        },
        "version": {
          "default": "1.0",
          "title": "Version",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "title": "Metadata",
      "type": "object"
    },
    "ValueFlowStage": {
      "description": "A stage in the value flow.",
      "properties": {
        "stage": {
          "description": "Stage name",
          "minLength": 1,
          "title": "Stage",
          "type": "string"
        },
        "activities": {
          "description": "Activities in this stage",
          "items": {
            "type": "string"
          },
          "title": "Activities",
          "type": "array"
        }
      },
      "required": [
        "stage"
      ],
      "title": "ValueFlowStage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Business scenario model.",
  "properties": {
    "id": {
      "minLength": 1,
      "pattern": "^[a-z0-9-]+$",
      "title": "Id",
      "type": "string"
    },
    "name": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "description": {
      "minLength": 1,
      "title": "Description",
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/Metadata"
    },
    "industry": {
      "description": "Industry this scenario belongs to",
      "title": "Industry",
      "type": "string"
    },
    "sub_industry": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Sub-industry classification",
      "title": "Sub Industry"
    },
    "tags": {
      "description": "Searchable tags",
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    },
    "value_flow": {
      "description": "Value creation flow",
      "items": {
        "$ref": "#/$defs/ValueFlowStage"
      },
      "title": "Value Flow",
      "type": "array"
    },
    "key_metrics": {
      "description": "Key performance metrics",
      "items": {
        "type": "string"
      },
      "title": "Key Metrics",
      "type": "array"
    },
    "traditional_pain_points": {
      "description": "Pain points in traditional approach",
      "items": {
        "type": "string"
      },
      "title": "Traditional Pain Points",
      "type": "array"
    },
    "ai_opportunities": {
      "description": "Opportunities for AI application",
      "items": {
        "type": "string"
      },
      "title": "Ai Opportunities",
      "type": "array"
    },
    "related_scenarios": {
      "description": "Related scenario IDs",
      "items": {
        "type": "string"
      },
      "title": "Related Scenarios",
      "type": "array"
    }
  },
  "required": [
    "id",
    "name",
    "description",
    "industry"
  ],
  "title": "Scenario",
  "type": "object"
}